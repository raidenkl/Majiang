body.lanmode
    color: black
    background: white
    margin: 0 10px 15px
    #navi
        margin: 0
    #lanmode
        display: block
    > .version
        display: none

#lanmode
    display: none
    font-size: 14px
    font-family: menu-font
    h1
        font-size: 24px
        margin-top: 0
        border-bottom: solid 2px black
        img
            height: 36px
            vertical-align: bottom
    > .version
        margin-top: -2.4em
        font-size: 16px
        font-family: defen-font
        text-align: right
    .panel
        border: solid 1px #666
        border-radius: 8px
        padding: 16px
        margin: 20px
        .desc
            margin: 0 0 12px
            color: #444
    .lan-toggle
        cursor: pointer
        font-size: 16px
        font-family: text-font
        padding: 6px 1.5em
        border: solid 2px #666
        border-radius: 6px
        background: white
        color: #666
        &.on
            border-color: green
            background: green
            color: white
    .state
        margin: 10px 0 0
        font-family: text-font
        font-size: 13px
        color: #444
    .invite
        margin: 6px 0 0
        font-family: fixed-font
        font-size: 13px
        color: green
        word-break: break-all
    .error
        margin: 6px 0 0
        font-family: text-font
        font-size: 13px
        color: red
    .proceed-row
        margin: 0 20px
        text-align: right
    .proceed
        cursor: pointer
        font-size: 16px
        font-family: text-font
        padding: 6px 2em
        border: none
        border-radius: 4px
        background: blue
        color: white
        &:hover
        &:focus
            background: #ccc
            outline: none
